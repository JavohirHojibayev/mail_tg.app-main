# =====================================================
# UZ-Potash Korporativ Pochta Telegram Bot Sozlamalari
# Namuna fayl (.env.example) - GitHub uchun xavfsiz
# =====================================================

# 1. Telegram Bot Token (@BotFather dan olingan token)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Pochta Tizimi & Domen
MAIL_SERVER=127.0.0.1
MAIL_DOMAIN=uz-potash.uz

# 3. PostgreSQL (iRedMail vmail bazasi)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vmail
DB_USER=vmailadmin
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# 4. SSH sozlamalari (ixtiyoriy)
SSH_HOST=YOUR_SSH_HOST_HERE
SSH_USER=YOUR_SSH_USER_HERE
SSH_PASSWORD=YOUR_SSH_PASSWORD_HERE

# 5. Bot Administratori
ADMIN_USERNAME=Javohir_Hojibayev
PAGE_SIZE=10

# 6. iRedAdmin Web sozlamalari (ixtiyoriy)
IREDADMIN_URL=https://mail.uz-potash.uz/iredadmin
IREDADMIN_USER=admin@uz-potash.uz
IREDADMIN_PASSWORD=YOUR_IREDADMIN_PASSWORD_HERE

# 7. Xodim ma'lumotlarini o'zgartirish paroli
ADMIN_EDIT_PASSWORD=YOUR_ADMIN_EDIT_PASSWORD_HERE


